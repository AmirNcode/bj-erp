# =============================================================================
# BJ ERP self-host configuration — generated automatically by install.sh.
# You normally never create this by hand; documented here for reference.
# =============================================================================

# Address employees use to reach the app (LAN IP or internal domain).
APP_HOST=192.168.1.10

# Secrets — generated once at install; changing them breaks existing logins.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# App image tag started by docker compose.
APP_VERSION=latest
