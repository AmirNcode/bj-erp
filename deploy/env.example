# =============================================================================
# BJ ERP self-host configuration — generated automatically by install.sh.
# You normally never create this by hand; documented here for reference.
# =============================================================================

# Bare hostname or LAN IP — NO port. This is the name on the TLS certificate
# and the Caddy site address; Caddy always listens on 443 inside its container.
APP_HOST=192.168.1.10

# HTTPS port published on the server. 443 is the default; set another (e.g.
# 3500) when IT reserves the standard ports. Port 80 is never published.
APP_PORT=443

# The URL employees actually type — APP_HOST plus APP_PORT when it is not 443.
# Baked into the browser bundle, so it MUST match what the browser shows, port
# included; a mismatch makes the login request go to a port nothing listens on.
APP_ORIGIN=https://192.168.1.10

# Secrets — generated once at install; changing them breaks existing logins.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# App image tag started by docker compose.
APP_VERSION=latest

# ── Login abuse protection ───────────────────────────────────────────────────
# GoTrue v2.170.0 /token refill rate per IP per FIVE MINUTES; burst capacity 30.
# 300 means 1 request/second sustained (~3600/hour), shared by password logins
# and session refreshes from the same public IP. This is not a per-user limit.
# The old RATE_LIMIT_TOKEN_PER_IP_HOUR name remains a compatibility fallback;
# its number had the same five-minute units. The new name takes precedence.
# Change takes effect on:
#   docker compose up -d --force-recreate auth
RATE_LIMIT_TOKEN_PER_IP_5_MINUTES=300

# Which upstream proxy is allowed to declare the real client IP via
# X-Forwarded-For. SECURITY BOUNDARY: anything trusted here can claim to be any
# user and drain their rate-limit bucket.
#   127.0.0.1/32  trusts nobody — correct while employees reach this server
#                 directly over the LAN/VPN (the default).
#   <gateway>/32  the company gateway's own address, once the app is published
#                 on a public subdomain behind it.
# Never widen this to whole private ranges.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
