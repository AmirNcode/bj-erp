# =============================================================================
# BJ ERP self-host configuration — generated automatically by install.sh.
# You normally never create this by hand; documented here for reference.
# =============================================================================

# Bare hostname or LAN IP — NO port. This is the name on the TLS certificate
# and the Caddy site address; Caddy always listens on 443 inside its container.
APP_HOST=192.168.1.10

# HTTPS port published on the server. 443 is the default; set another (e.g.
# 3500) when IT reserves the standard ports. Port 80 is never published.
APP_PORT=443

# The URL employees actually type — APP_HOST plus APP_PORT when it is not 443.
# Baked into the browser bundle, so it MUST match what the browser shows, port
# included; a mismatch makes the login request go to a port nothing listens on.
APP_ORIGIN=https://192.168.1.10

# Secrets — generated once at install; changing them breaks existing logins.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# App image tag started by docker compose.
APP_VERSION=latest
